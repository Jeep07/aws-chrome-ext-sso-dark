{
  "manifest_version": 3,
  "name": "AWS SSO Dark",
  "version": "0.1.2",
  "description": "Dark mode for AWS SSO pages, so re-auth at 6 AM does not flashbang you.",
  "icons": {
    "16": "icons/aws-sso-dark-16.png",
    "32": "icons/aws-sso-dark-32.png",
    "48": "icons/aws-sso-dark-48.png",
    "128": "icons/aws-sso-dark-128.png"
  },
  "action": {
    "default_title": "AWS SSO Dark",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/aws-sso-dark-16.png",
      "32": "icons/aws-sso-dark-32.png",
      "48": "icons/aws-sso-dark-48.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.signin.aws/*",
    "https://*.awsapps.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.signin.aws/platform/*/login*",
        "https://*.awsapps.com/start/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "css": ["src/theme.css"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
